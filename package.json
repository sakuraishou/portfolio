{
  "name": "portfolio",
  "version": "1.0.0",
  "description": "Next.js（App Router）× Payload CMS で構築した桜井 翔のポートフォリオサイト。実績・スキルを CMS で構造化し、型生成でフロントと接続する",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "cross-env NODE_OPTIONS=\"--no-deprecation --max-old-space-size=8000\" next build",
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev",
    "devsafe": "rm -rf .next && cross-env NODE_OPTIONS=--no-deprecation next dev",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "lint": "eslint .",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start",
    "test": "pnpm run test:e2e",
    "test:e2e": "cross-env NODE_OPTIONS=\"--no-deprecation --import=tsx/esm\" playwright test --config=playwright.config.ts"
  },
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "^7.3.1",
    "@fortawesome/free-solid-svg-icons": "^7.3.1",
    "@fortawesome/react-fontawesome": "^3.5.0",
    "@gsap/react": "^2.1.2",
    "@next/third-parties": "16.4.4",
    "@payloadcms/db-postgres": "3.92.1",
    "@payloadcms/next": "3.92.1",
    "@payloadcms/richtext-lexical": "3.92.1",
    "@payloadcms/ui": "3.92.1",
    "cross-env": "^7.0.3",
    "dotenv": "16.6.1",
    "fast-copy": "^3.1.0",
    "graphql": "^16.14.2",
    "gsap": "^3.15.0",
    "next": "16.4.4",
    "nodemailer": "^10.3.1",
    "payload": "3.92.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "ress": "^5.0.2",
    "sass": "^1.107.1",
    "sharp": "0.35.5",
    "@payloadcms/translations": "3.92.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.4",
    "prettier": "^3.9.10",
    "tsx": "4.23.15",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": ">=24.22.1",
    "pnpm": ">=11"
  },
  "packageManager": "pnpm@11.28.9"
}
